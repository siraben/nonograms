# Frontend (Vite)
VITE_TURNSTILE_SITE_KEY=

# Wrangler local dev (Pages Functions)
# These are read by wrangler when running `wrangler pages dev` if you put them in `.dev.vars`.
TURNSTILE_SECRET_KEY=
# Explicitly set only in local development when Turnstile is intentionally disabled.
TURNSTILE_DEV_BYPASS=1
BOOTSTRAP_TOKEN=
INVITES_REQUIRED=1
